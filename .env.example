# =====================================================================
# Variables d'environnement — Patro Notre-Dame d'Ittre (v3.0, Netlify DB)
# =====================================================================
#
# NETLIFY_DATABASE_URL est INJECTEE AUTOMATIQUEMENT par Netlify dès que
# vous activez "Netlify DB" (Postgres/Neon) sur ce site depuis le
# dashboard Netlify (Site settings -> Database). Vous n'avez PAS besoin
# de la définir vous-même : @netlify/neon la lit automatiquement, y
# compris avec la bonne branche de base de données selon le contexte
# (production, deploy preview, branch deploy).
#
# Ne définissez cette variable manuellement QUE si vous développez en
# local sans passer par `netlify dev` (cas rare) :
# NETLIFY_DATABASE_URL=postgres://...

# Clé secrète pour la page de récupération d'urgence de l'accès admin
# (recuperation-admin.html). Changez cette valeur en production !
ADMIN_RECOVERY_KEY=PATRO-RECUP-2024

# Optionnel : envoi de vrais e-mails via Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Patro Notre-Dame d'Ittre <pndi@patro.be>
